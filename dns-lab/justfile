# DNS lab for the "DNS y DNSSEC para Operadores" course. See GOAL.md for
# the design and README.md for usage. Run on the lab host itself.
#
# Parameters, in order of precedence:
#   just groups=3 host=lab.example.org <recipe>   # command line
#   DNSLAB_GROUPS=3 / DNSLAB_HOST=... in .env      # per-host defaults
#   6 groups on kobe.labs.lacnic.net               # built-in defaults

set dotenv-load
set shell := ["bash", "-euo", "pipefail", "-c"]

# Number of student groups; each gets three nodes, groupNN-0..2.
groups := env("DNSLAB_GROUPS", "6")
# Public name of the lab host: the web page's URL and certificate.
host := env("DNSLAB_HOST", "kobe.labs.lacnic.net")

network := "dns-lab"
state := justfile_directory() / "state"

# The master's second network, a normal Docker bridge to the Internet.
uplink := "dns-lab-uplink"

# Addressing (GOAL.md, README.md): master .0.1 / ::1, node groupGG-N at
# 10.53.GG.(10+N) / fd53::GG:(10+N). The host's end of the bridge sits
# out of the way at .255.254 / ::ffff.
lab4 := "10.53.0.0/16"
lab6 := "fd53::/64"
master4 := "10.53.0.1"
master6 := "fd53::1"

node_image := "dnslab-node"
master_image := "dnslab-master"
master_name := "dnslab-master"
# systemd as PID 1 without --privileged: images/node/dnslab-init.sh
# remounts the container's own cgroup subtree read-write, which needs
# SYS_ADMIN and no AppArmor profile. NET_ADMIN lets dnslab-net set the
# default route via the master. See images/node/README.md.
node_run_flags := "--cgroupns=private --cap-add SYS_ADMIN --cap-add NET_ADMIN --security-opt apparmor=unconfined --tmpfs /run --tmpfs /run/lock --tmpfs /tmp"

# List the recipes.
default:
    @just --list --unsorted

# Create a new environment: network, master, nodes, web page.
init: _check
    @echo "init (not implemented yet, see #5) would, on {{host}}:"
    @echo "  - build the node and master images if missing (#2, #4)"
    @echo "  - create the {{network}} network with fixed IPv4/IPv6 addressing (#3)"
    @echo "  - start the master: NAT gateway, lab. parent zone, validating resolver (#4)"
    @echo "  - start {{groups}} groups x 3 nodes: $(just groups={{groups}} _nodes | tr '\n' ' ')"
    @echo "  - generate credentials in {{state}}/credentials"
    @echo "  - start the web page behind Caddy at https://{{host}} (#8, #11)"

# Remove the environment completely (backs up first).
destroy: _check
    @echo "destroy (not implemented yet, see #7) would, on {{host}}:"
    @echo "  - run 'just backup', then ask for confirmation"
    @echo "  - remove the master, every groupNN-N node, the web page and Caddy"
    @echo "  - remove the {{network}} network and {{state}}, except {{state}}/backups"

# Save every node's config, zones and keys to a tarball.
backup: _check
    @echo "backup (not implemented yet, see #6) would, on {{host}}:"
    @echo "  - archive each node's bind mount under {{state}}/nodes, the master's state"
    @echo "    and the credentials into {{state}}/backups/dns-lab-{{host}}-<timestamp>.tar.gz"

# Show the parameters and, once implemented, every container's state.
status: _check
    @echo "host:    {{host}}"
    @echo "groups:  {{groups}} ($(( {{groups}} * 3 )) nodes + master)"
    @echo "network: {{network}}"
    @echo "state:   {{state}}"
    @echo "nodes:   $(just groups={{groups}} _nodes | tr '\n' ' ')"
    @echo "(container states: not implemented yet, see #5)"

# Print the web page's group and instructor passwords.
credentials: _check
    @echo "credentials (not implemented yet, see #5) would print {{state}}/credentials"

# Build the lab images.
build:
    docker build -t {{node_image}} images/node
    docker build -t {{master_image}} images/master

# Bring up the network, the master and groups 1-2, check addressing and routing, tear down.
test-net: build
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{state}}/test"
    nodes=(group01-0 group01-1 group01-2 group02-0 group02-1 group02-2)
    if docker network inspect {{network}} >/dev/null 2>&1; then
        echo "A {{network}} environment already exists on this host; test-net needs it absent." >&2; exit 1
    fi
    cleanup() {
        docker rm -f {{master_name}} "${nodes[@]}" >/dev/null 2>&1 || true
        docker network rm {{network}} {{uplink}} >/dev/null 2>&1 || true
        sudo rm -rf "$root"
    }
    trap cleanup EXIT
    cleanup
    just _network
    just _master "$root"
    for g in 1 2; do for n in 0 1 2; do just _node "$root" $g $n; done; done
    for c in {{master_name}} "${nodes[@]}"; do just _wait "$c"; done
    x() { docker exec "$@"; }
    ok() { echo "ok   $*"; }
    fail() { echo "FAIL $*" >&2; exit 1; }
    for g in 1 2; do for n in 0 1 2; do
        c=$(printf 'group%02d-%d' $g $n); a4="10.53.$g.$((10 + n))"; a6="fd53::$g:$((10 + n))"
        x "$c" ip -br addr show eth0 | grep -w "$a4/16" | grep -qw "$a6/64" \
            || fail "$c doesn't have $a4 and $a6"
    done; done
    ok "every node has its 10.53.G.(10+N) and fd53::G:(10+N) address"
    x group01-0 ping -c1 -W2 {{master4}} >/dev/null && x group01-0 ping -c1 -W2 {{master6}} >/dev/null \
        && ok "node pings the master over IPv4 and IPv6" || fail "node can't ping the master"
    x group01-0 ping -c1 -W2 10.53.2.12 >/dev/null && x group01-0 ping -c1 -W2 fd53::2:12 >/dev/null \
        && ok "node pings another group's node over IPv4 and IPv6" || fail "node can't ping group02-2"
    x group01-0 ip route show default | grep -q "via {{master4}}" \
        && ok "default route via {{master4}}" || fail "no default route via the master"
    x group01-0 curl -sSI -m 10 -o /dev/null https://www.lacnic.net \
        && ok "node reaches https://www.lacnic.net through the master" || fail "node can't reach the Internet"
    srv=$(x group01-0 dig www.lacnic.net | sed -n 's/^;; SERVER: \([^#]*\)#.*/\1/p')
    [ "$srv" = {{master4}} ] && ok "dig on a node is answered by {{master4}}" || fail "dig answered by '$srv'"
    docker stop {{master_name}} >/dev/null
    ! x group01-0 curl -sSI -m 5 -o /dev/null https://1.1.1.1 2>/dev/null \
        && ok "with the master stopped, the node can't reach the Internet" || fail "node bypasses the master"
    docker start {{master_name}} >/dev/null; just _wait_resolver
    x group01-0 curl -sSI -m 10 -o /dev/null https://www.lacnic.net \
        && ok "Internet access is back once the master restarts" || fail "no Internet after master restart"
    echo "all network checks passed"

# Create the internal dns-lab network and the master's uplink, if missing.
[private]
_network:
    @docker network inspect {{network}} >/dev/null 2>&1 || docker network create --internal \
        --subnet {{lab4}} --gateway 10.53.255.254 --ipv6 --subnet {{lab6}} --gateway fd53::ffff {{network}}
    @docker network inspect {{uplink}} >/dev/null 2>&1 || docker network create {{uplink}}

# Create and start the master: 10.53.0.1 on dns-lab plus the uplink, NAT on.
[private]
_master root=state:
    #!/usr/bin/env bash
    set -euo pipefail
    dir="{{root}}/master"
    mkdir -p "$dir"/{etc-bind,var-cache-bind,var-lib-bind}
    docker create --name {{master_name}} --hostname {{master_name}} {{node_run_flags}} \
        --network {{network}} --ip {{master4}} --ip6 {{master6}} \
        --sysctl net.ipv4.ip_forward=1 \
        -e DNSLAB_LAB4={{lab4}} -e DNSLAB_RESOLVER=127.0.0.1 \
        -v "$dir/etc-bind:/etc/bind" -v "$dir/var-cache-bind:/var/cache/bind" \
        -v "$dir/var-lib-bind:/var/lib/bind" {{master_image}} >/dev/null
    docker network connect {{uplink}} {{master_name}}
    docker start {{master_name}} >/dev/null
    just _wait_resolver
    echo "started {{master_name}} ({{master4}}, {{master6}})"

# Wait up to 60 s for the master's resolver to answer: named is up a few
# seconds before it can resolve (root priming, trust anchor), and nodes
# booting meanwhile would see lookups fail.
[private]
_wait_resolver:
    @for _ in $(seq 60); do docker exec {{master_name}} dig +time=1 +tries=1 @127.0.0.1 . SOA 2>/dev/null | grep "status: NOERROR" >/dev/null && exit 0; sleep 1; done; \
        echo "{{master_name}}: resolver not answering after 60 s" >&2; exit 1

# Create and start node groupGG-N with its fixed addresses.
[private]
_node root g n:
    #!/usr/bin/env bash
    set -euo pipefail
    name=$(printf 'group%02d-%d' {{g}} {{n}})
    a4="10.53.$((10#{{g}})).$((10 + {{n}}))"; a6="fd53::$((10#{{g}})):$((10 + {{n}}))"
    dir="{{root}}/nodes/$name"
    mkdir -p "$dir"/{etc-bind,var-cache-bind,var-lib-bind}
    docker run -d --name "$name" --hostname "$name" {{node_run_flags}} \
        --network {{network}} --ip "$a4" --ip6 "$a6" \
        -e DNSLAB_GW4={{master4}} -e DNSLAB_RESOLVER={{master4}} \
        -v "$dir/etc-bind:/etc/bind" -v "$dir/var-cache-bind:/var/cache/bind" \
        -v "$dir/var-lib-bind:/var/lib/bind" {{node_image}} >/dev/null
    echo "started $name ($a4, $a6)"

# Wait up to 30 s for a container's named to be up.
[private]
_wait name:
    @for _ in $(seq 30); do docker exec {{name}} systemctl is-active -q named 2>/dev/null && exit 0; sleep 1; done; \
        echo "{{name}}: named not up after 30 s" >&2; exit 1

# Boot a throwaway node and check it: systemd, bind9, tools, bind mounts, clean stop.
test-node: build
    #!/usr/bin/env bash
    set -euo pipefail
    name=dnslab-test-node
    dir="{{state}}/test/$name"
    cleanup() { docker rm -f "$name" >/dev/null 2>&1 || true; sudo rm -rf "{{state}}/test"; }
    trap cleanup EXIT
    cleanup
    mkdir -p "$dir"/{etc-bind,var-cache-bind,var-lib-bind}
    docker run -d --name "$name" --hostname "$name" {{node_run_flags}} \
        -v "$dir/etc-bind:/etc/bind" -v "$dir/var-cache-bind:/var/cache/bind" \
        -v "$dir/var-lib-bind:/var/lib/bind" {{node_image}} >/dev/null
    x() { docker exec "$name" "$@"; }
    ok() { echo "ok   $*"; }
    fail() { echo "FAIL $*" >&2; exit 1; }
    for _ in $(seq 30); do x systemctl is-active -q named 2>/dev/null && break; sleep 1; done
    [ "$(x systemctl is-system-running || true)" = running ] && ok "systemd running, no failed units" \
        || { x systemctl --failed; fail "systemd not running cleanly"; }
    x systemctl is-active -q bind9 && ok "systemctl: bind9 active" || fail "bind9 not active"
    x journalctl -u named | grep 'running as: named' >/dev/null && ok "journalctl -u named shows named's log" \
        || fail "no named log in the journal"
    x rndc status | grep 'server is up' >/dev/null && ok "rndc status" || fail "rndc status"
    x named-checkconf && ok "named-checkconf" || fail "named-checkconf"
    for t in dig delv drill dnssec-keygen dnssec-signzone named-checkzone; do
        x sh -c "command -v $t >/dev/null" || fail "$t missing"
    done
    ok "dig delv drill dnssec-keygen dnssec-signzone named-checkzone present"
    [ "$(x dig +short @127.0.0.1 localhost A)" = 127.0.0.1 ] && ok "named answers queries" || fail "named doesn't answer"
    [ -s "$dir/etc-bind/named.conf" ] && sudo test -s "$dir/etc-bind/rndc.key" \
        && ok "empty bind mount seeded, rndc.key generated" || fail "bind mount not seeded"
    mark="// dnslab test $(date +%s)"
    echo "$mark" | sudo tee -a "$dir/etc-bind/named.conf.local" >/dev/null
    [ "$(x tail -1 /etc/bind/named.conf.local)" = "$mark" ] && ok "host edit visible in /etc/bind" || fail "host edit not visible"
    docker restart "$name" >/dev/null
    for _ in $(seq 30); do x systemctl is-active -q named 2>/dev/null && break; sleep 1; done
    [ "$(x tail -1 /etc/bind/named.conf.local)" = "$mark" ] && x systemctl is-active -q named \
        && ok "edit survives docker restart, named back up" || fail "edit lost or named down after restart"
    start=$(date +%s)
    docker stop "$name" >/dev/null
    took=$(( $(date +%s) - start ))
    code=$(docker inspect "$name" --format '{{{{.State.ExitCode}}')
    (( took < 10 )) && [ "$code" = 0 ] && ok "docker stop clean in ${took}s" || fail "stop took ${took}s, exit $code"
    [ "$(docker inspect "$name" --format '{{{{.HostConfig.Privileged}}')" = false ] && ok "not privileged" || fail "privileged"
    echo "all node checks passed"

# Fail early on a bad parameter. Two-digit group names and the
# 10.53.GG.0/24 addressing (GOAL.md) cap the lab at 99 groups.
[private]
_check:
    @[[ "{{groups}}" =~ ^[0-9]+$ ]] && (( {{groups}} >= 1 && {{groups}} <= 99 )) \
        || { echo "groups must be a number from 1 to 99, got '{{groups}}'" >&2; exit 1; }
    @[[ -n "{{host}}" ]] || { echo "host must not be empty" >&2; exit 1; }

# Node container names, one per line.
[private]
_nodes:
    @for g in $(seq 1 {{groups}}); do for n in 0 1 2; do printf 'group%02d-%d\n' $g $n; done; done
