# DNS lab for the "DNS y DNSSEC para Operadores" course. See GOAL.md for
# the design and README.md for usage. Run on the lab host itself.
#
# Parameters, in order of precedence:
#   just groups=3 host=lab.example.org <recipe>   # command line
#   DNSLAB_GROUPS=3 / DNSLAB_HOST=... in .env      # per-host defaults
#   6 groups on kobe.labs.lacnic.net               # built-in defaults

set dotenv-load
set shell := ["bash", "-euo", "pipefail", "-c"]

# Number of student groups; each gets three nodes, groupNN-0..2.
groups := env("DNSLAB_GROUPS", "6")
# Public name of the lab host: the web page's URL and certificate.
host := env("DNSLAB_HOST", "kobe.labs.lacnic.net")
# destroy's options: don't back up first, don't ask, also remove the images.
skip_backup := "false"
yes := "false"
images := "false"

network := "dns-lab"
state := justfile_directory() / "state"

# The master's second network, a normal Docker bridge to the Internet.
uplink := "dns-lab-uplink"
# Caddy and the web app talk over this bridge; the lab can't reach it.
front := "dns-lab-front"

# Addressing (GOAL.md, README.md): master .0.1 / ::1, node groupGG-N at
# 10.53.GG.(10+N) / fd53::GG:(10+N). The host's end of the bridge sits
# out of the way at .255.254 / ::ffff.
lab4 := "10.53.0.0/16"
lab6 := "fd53::/64"
master4 := "10.53.0.1"
master6 := "fd53::1"

node_image := "dnslab-node"
master_image := "dnslab-master"
master_name := "dnslab-master"
web_image := "dnslab-web"
web_name := "dnslab-web"
# The web app listens on the host's loopback only, for the tests and SSH
# tunnels; Caddy is the public entry point.
web_port := "8080"
caddy_image := "caddy:2.8.4"
caddy_name := "dnslab-caddy"
# Host inotify limits (#28). They are per user, so every lab container's
# systemd (all root on the host) shares them; Ubuntu's 128 instances run out
# at about 19 containers and systemctl then fails with "Too many open files".
inotify_instances := "8192"
inotify_watches := "524288"
sysctl_conf := "/etc/sysctl.d/90-dns-lab.conf"
# What of state/ makes up an environment (backed up, restored, torn down); not backups/.
state_items := "env credentials nodes master shared web caddy"
# systemd as PID 1 without --privileged: images/node/dnslab-init.sh
# remounts the container's own cgroup subtree read-write, which needs
# SYS_ADMIN and no AppArmor profile. NET_ADMIN lets dnslab-net set the
# default route via the master. See images/node/README.md.
node_run_flags := "--cgroupns=private --cap-add SYS_ADMIN --cap-add NET_ADMIN --security-opt apparmor=unconfined --tmpfs /run --tmpfs /run/lock --tmpfs /tmp"

# List the recipes.
default:
    @just --list --unsorted

# Create a new environment: network, master, nodes, web page, Caddy.
init: _check
    #!/usr/bin/env bash
    set -euo pipefail
    found=$(just _existing)
    if [ -n "$found" ]; then
        echo "A dns-lab environment already exists on this host; init changed nothing." >&2
        echo "$found" | head -5 | sed 's/^/  /' >&2
        n=$(echo "$found" | wc -l); (( n <= 5 )) || echo "  … and $(( n - 5 )) more" >&2
        echo "See 'just status'; remove it with 'just destroy' first." >&2
        exit 1
    fi
    just _inotify
    trap 'echo "init failed; the environment is incomplete. See just status." >&2' ERR
    for image in {{node_image}}:images/node {{master_image}}:images/master {{web_image}}:web; do
        docker image inspect "${image%%:*}" >/dev/null 2>&1 || docker build -q -t "${image%%:*}" "${image#*:}" >/dev/null
    done
    docker image inspect {{caddy_image}} >/dev/null 2>&1 || docker pull -q {{caddy_image}} >/dev/null
    echo "images ready"
    just _network >/dev/null
    echo "created networks {{network}} ({{lab4}}, {{lab6}}), {{uplink}}, {{front}}"
    mkdir -p "{{state}}"
    printf 'DNSLAB_GROUPS=%s\nDNSLAB_HOST=%s\n' {{groups}} {{host}} > "{{state}}/env"
    just groups={{groups}} _master
    for g in $(seq 1 {{groups}}); do for n in 0 1 2; do just _node "{{state}}" $g $n; done; done
    for c in $(just groups={{groups}} _nodes); do just _wait "$c"; done
    echo "every node's named is up"
    just groups={{groups}} _credentials
    just _web
    just host={{host}} _cert
    just host={{host}} _caddy
    echo
    echo "Environment ready: {{groups}} groups on https://{{host}}/"
    echo "  just credentials   the passwords to hand out"
    echo "  just cert          the certificate's fingerprint (self-signed until #11)"
    echo "  just status        containers and addresses"

# Remove the environment completely, after confirmation and a backup (skip_backup=true, yes=true, images=true).
destroy: _check
    #!/usr/bin/env bash
    set -euo pipefail
    found=$(just _existing)
    if [ -z "$found" ]; then
        echo "No dns-lab environment on this host; nothing to destroy."
        if [ "{{images}}" = true ]; then just _rmi; fi
        exit 0
    fi
    list() { echo "$found" | sed -n "s/^$1 //p" | sort -V | tr '\n' ' '; }
    echo "This removes the dns-lab environment on this host:"
    echo "  containers ($(echo "$found" | grep -c '^container ' || true)): $(list container)"
    echo "  networks: $(list network)"
    echo "  everything under {{state}} except backups/"
    if [ "{{images}}" = true ]; then echo "  the lab images"; fi
    if [ "{{skip_backup}}" != true ]; then echo "It runs 'just backup' first."; else echo "No backup (skip_backup=true)."; fi
    if [ "{{yes}}" != true ]; then
        read -r -p "Type yes to go ahead: " answer || true
        [ "${answer:-}" = yes ] || { echo "destroy cancelled; nothing changed." >&2; exit 1; }
    fi
    if [ "{{skip_backup}}" != true ]; then
        if [ -r "{{state}}/env" ]; then just backup
        else echo "No {{state}}/env (an incomplete init?), so no backup." >&2; fi
    fi
    just _teardown
    if [ "{{images}}" = true ]; then just _rmi; fi
    echo "destroyed the environment; backups are kept in {{state}}/backups"

# Save every node's config, zones and keys, the master's state and the credentials to state/backups.
backup: _check
    #!/usr/bin/env bash
    set -euo pipefail
    [ -r "{{state}}/env" ] || { echo "No environment to back up: {{state}}/env is created by 'just init'." >&2; exit 1; }
    . "{{state}}/env"
    mkdir -p "{{state}}/backups"
    # One second resolution: wait out a backup taken in the same second
    # (destroy right after a manual backup) rather than overwrite it.
    while file="{{state}}/backups/dns-lab-$DNSLAB_HOST-$(date +%Y%m%d-%H%M%S).tar.gz"; [ -e "$file" ]; do sleep 1; done
    items=$(cd "{{state}}" && ls -d {{state_items}} 2>/dev/null || true)
    # Zones and keys belong to the containers' bind user, hence sudo; numeric
    # owners, so a restore gives them back to that uid whatever the host calls
    # it. GNU tar exits 1 if a running named wrote a file while it was read.
    rc=0; (umask 077; sudo tar -czf - --numeric-owner --warning=no-file-changed -C "{{state}}" $items > "$file") || rc=$?
    (( rc <= 1 )) || { rm -f "$file"; echo "backup failed (tar exit $rc)" >&2; exit 1; }
    chmod 600 "$file"
    echo "saved $file ($(du -h "$file" | cut -f1); $(ls "{{state}}/nodes" | wc -l) nodes, master, credentials)"

# Put a backup back into a matching environment: back up, stop the lab, replace state/, start it.
restore file: _check
    #!/usr/bin/env bash
    set -euo pipefail
    file=$(cd "{{invocation_directory()}}" && realpath "{{file}}")
    [ -r "$file" ] || { echo "Can't read $file" >&2; exit 1; }
    from=$(tar -xzOf "$file" env 2>/dev/null) || { echo "$file isn't a dns-lab backup (no env in it)" >&2; exit 1; }
    want=$(echo "$from" | sed -n 's/^DNSLAB_GROUPS=//p'); want_host=$(echo "$from" | sed -n 's/^DNSLAB_HOST=//p')
    have=$(cat "{{state}}/env" 2>/dev/null || true)
    if [ "$have" != "$from" ]; then
        echo "This backup is from an environment with $want groups on $want_host; there is ${have:+a different one}${have:-none} here." >&2
        echo "Create a matching one first: just groups=$want host=$want_host init (after 'just destroy' if needed)." >&2
        exit 1
    fi
    just backup
    trap 'echo "restore failed; the state before it is in the backup above. See just status." >&2' ERR
    docker stop $(docker ps -q --filter label=dnslab.role) >/dev/null
    echo "stopped the lab"
    for f in {{state_items}}; do sudo rm -rf "{{state}}/$f"; done
    sudo tar -xzf "$file" --numeric-owner -C "{{state}}"
    echo "restored {{state}} from $file"
    docker start {{master_name}} >/dev/null; just _wait_resolver
    nodes=$(just groups=$want _nodes)
    docker start $nodes >/dev/null
    for c in $nodes; do just _wait "$c"; done
    docker start {{web_name}} {{caddy_name}} >/dev/null
    for _ in $(seq 30); do curl -sk -o /dev/null --resolve $want_host:443:127.0.0.1 https://$want_host/login 2>/dev/null && break; sleep 1; done
    echo "started the master, $(echo $nodes | wc -w) nodes, the web page and Caddy"

# Show the environment's parameters and every lab container's state and addresses.
status: _check
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -r "{{state}}/env" ]; then
        . "{{state}}/env"
        echo "environment: $DNSLAB_GROUPS groups on https://$DNSLAB_HOST/ (state in {{state}})"
    else
        echo "no environment created by 'just init' here (parameters: {{groups}} groups, host {{host}})"
    fi
    names=$(docker ps -a --filter label=dnslab.role --format '{{{{.Names}}' | sort)
    if [ -z "$names" ]; then echo "no lab containers on this host"; exit 0; fi
    # master first, then nodes, then web and Caddy
    names=$(echo "$names" | awk '/^dnslab-master$/ { print 0, $0; next } /^group/ { print 1, $0; next } { print 2, $0 }' | sort | cut -d' ' -f2)
    printf '%-15s %-10s %-12s %s\n' CONTAINER STATE IPV4 IPV6
    # The fixed addresses given at creation, so stopped containers show them too
    docker inspect -f '{{{{.Name}} {{{{.State.Status}} {{{{with index .NetworkSettings.Networks "{{network}}"}}{{{{with .IPAMConfig}}{{{{.IPv4Address}} {{{{.IPv6Address}}{{{{end}}{{{{end}}' $names \
        | while read -r name state v4 v6; do printf '%-15s %-10s %-12s %s\n' "${name#/}" "$state" "${v4:--}" "${v6:--}"; done

# Print the web page's certificate: its path, names, expiry and fingerprint.
cert:
    @[ -r "{{state}}/caddy/cert.pem" ] || { echo "No certificate yet: {{state}}/caddy/cert.pem is created by 'just init'." >&2; exit 1; }
    @echo "{{state}}/caddy/cert.pem"
    @openssl x509 -in "{{state}}/caddy/cert.pem" -noout -ext subjectAltName -enddate -fingerprint -sha256 | sed '/^X509v3/d; s/^ *//'

# Print the web page's group and instructor passwords.
credentials:
    @[ -r "{{state}}/credentials" ] && cat "{{state}}/credentials" \
        || { echo "No credentials yet: {{state}}/credentials is created by 'just init'." >&2; exit 1; }

# Build the lab images.
build:
    docker build -t {{node_image}} images/node
    docker build -t {{master_image}} images/master
    docker build -t {{web_image}} web

# Bring up the network, the master and groups 1-2, check addressing and routing, tear down.
test-net: build
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{state}}/test"
    nodes=(group01-0 group01-1 group01-2 group02-0 group02-1 group02-2)
    if docker network inspect {{network}} >/dev/null 2>&1; then
        echo "A {{network}} environment already exists on this host; test-net needs it absent." >&2; exit 1
    fi
    cleanup() {
        docker rm -f {{master_name}} "${nodes[@]}" >/dev/null 2>&1 || true
        docker network rm {{network}} {{uplink}} {{front}} >/dev/null 2>&1 || true
        sudo rm -rf "$root"
    }
    trap cleanup EXIT
    cleanup
    just _network
    just _master "$root"
    for g in 1 2; do for n in 0 1 2; do just _node "$root" $g $n; done; done
    for c in {{master_name}} "${nodes[@]}"; do just _wait "$c"; done
    x() { docker exec "$@"; }
    ok() { echo "ok   $*"; }
    fail() { echo "FAIL $*" >&2; exit 1; }
    for g in 1 2; do for n in 0 1 2; do
        c=$(printf 'group%02d-%d' $g $n); a4="10.53.$g.$((10 + n))"; a6="fd53::$g:$((10 + n))"
        x "$c" ip -br addr show eth0 | grep -w "$a4/16" | grep -qw "$a6/64" \
            || fail "$c doesn't have $a4 and $a6"
    done; done
    ok "every node has its 10.53.G.(10+N) and fd53::G:(10+N) address"
    x group01-0 ping -c1 -W2 {{master4}} >/dev/null && x group01-0 ping -c1 -W2 {{master6}} >/dev/null \
        && ok "node pings the master over IPv4 and IPv6" || fail "node can't ping the master"
    x group01-0 ping -c1 -W2 10.53.2.12 >/dev/null && x group01-0 ping -c1 -W2 fd53::2:12 >/dev/null \
        && ok "node pings another group's node over IPv4 and IPv6" || fail "node can't ping group02-2"
    x group01-0 ip route show default | grep -q "via {{master4}}" \
        && ok "default route via {{master4}}" || fail "no default route via the master"
    x group01-0 curl -sSI -m 10 -o /dev/null https://www.lacnic.net \
        && ok "node reaches https://www.lacnic.net through the master" || fail "node can't reach the Internet"
    srv=$(x group01-0 dig www.lacnic.net | sed -n 's/^;; SERVER: \([^#]*\)#.*/\1/p')
    [ "$srv" = {{master4}} ] && ok "dig on a node is answered by {{master4}}" || fail "dig answered by '$srv'"
    # #40: names whose nameservers live in other domains, with a cold cache.
    docker exec {{master_name}} rndc flush
    for n in archive.ubuntu.com security.ubuntu.com pypi.org github.com deb.debian.org; do
        [ "$(x group01-0 dig +time=10 +tries=1 $n A | grep -oE 'status: [A-Z]+')" = "status: NOERROR" ] || fail "cold cache: $n doesn't resolve"
    done
    ok "with a cold cache, archive/security.ubuntu.com, pypi.org, github.com, deb.debian.org resolve at once"
    docker exec {{master_name}} rndc flush
    x group01-0 apt-get install -y -q tree >/dev/null 2>&1 && ok "apt-get install on a node right after a cache flush" || fail "apt-get install"
    docker stop {{master_name}} >/dev/null
    ! x group01-0 curl -sSI -m 5 -o /dev/null https://1.1.1.1 2>/dev/null \
        && ok "with the master stopped, the node can't reach the Internet" || fail "node bypasses the master"
    docker start {{master_name}} >/dev/null; just _wait_resolver
    x group01-0 curl -sSI -m 10 -o /dev/null https://www.lacnic.net \
        && ok "Internet access is back once the master restarts" || fail "no Internet after master restart"
    echo "all network checks passed"

# Bring up the master and group01, check lab. and the resolver (incl. a signed group zone), tear down.
test-master: build
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{state}}/test"
    nodes=(group01-0 group01-1 group01-2)
    if docker network inspect {{network}} >/dev/null 2>&1; then
        echo "A {{network}} environment already exists on this host; test-master needs it absent." >&2; exit 1
    fi
    cleanup() {
        docker rm -f {{master_name}} "${nodes[@]}" >/dev/null 2>&1 || true
        docker network rm {{network}} {{uplink}} {{front}} >/dev/null 2>&1 || true
        sudo rm -rf "$root"
    }
    trap cleanup EXIT
    cleanup
    just _network
    just groups=2 _master "$root"
    for n in 0 1 2; do just _node "$root" 1 $n; done
    for c in "${nodes[@]}"; do just _wait "$c"; done
    x() { docker exec "$@"; }
    m() { docker exec -i {{master_name}} "$@"; }
    ok() { echo "ok   $*"; }
    fail() { echo "FAIL $*" >&2; exit 1; }
    flags() { sed -n 's/^;; flags: \([^;]*\);.*/\1/p'; }
    update() { m nsupdate -k /etc/bind/dnslab-webapp.key; }  # stdin: update lines, without server/send

    # 1. lab. through the resolver: signed, validated
    out=$(x group01-0 dig @{{master4}} lab. SOA +dnssec)
    echo "$out" | flags | grep -qw ad && echo "$out" | grep -q 'RRSIG.*SOA' \
        && ok "lab. SOA from the resolver is signed and validated (ad)" || fail "lab. SOA not validated: $(echo "$out" | flags)"

    # 2. delegation, authoritatively (RD=0 goes to the authoritative view)
    out=$(x group01-0 dig @{{master4}} group01.lab. NS +norec)
    ns=$(echo "$out" | grep -cE '^group01\.lab\.\s.*\sNS\s+ns[012]\.group01\.lab\.$')
    glue=$(echo "$out" | grep -cE '^ns[012]\.group01\.lab\.\s.*\s(A\s+10\.53\.1\.1[012]|AAAA\s+fd53::1:1[012])$')
    [ "$ns" = 3 ] && [ "$glue" = 6 ] && ok "group01.lab. delegated to ns0-2 with A and AAAA glue" \
        || fail "delegation: $ns NS, $glue glue records"

    # 3. delv validates lab. from the published trust anchor
    x group01-0 delv-lab @{{master4}} lab. SOA 2>&1 | grep -q 'fully validated' \
        && ok "delv-lab on a node: lab. SOA fully validated" || fail "delv-lab didn't validate lab."

    # 4. recursion for the lab only
    [ "$(x group01-0 dig +short @{{master4}} www.lacnic.net A | tail -1)" != "" ] \
        && ok "resolver answers a node for www.lacnic.net" || fail "resolver doesn't answer the lab"
    up=$(docker inspect {{master_name}} --format '{{{{(index .NetworkSettings.Networks "{{uplink}}").IPAddress}}')
    out=$(docker run --rm --network {{uplink}} --entrypoint dig {{node_image}} +time=2 +tries=1 @"$up" www.lacnic.net A)
    echo "$out" | grep -q 'status: REFUSED' \
        && ok "the same query from the uplink side ($up) is refused" || fail "uplink query not refused: $(echo "$out" | grep status)"

    # 5. dynamic updates: only the web page's key, only groupNN.lab. DS
    fake="group01.lab. 60 IN DS 12345 13 2 0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF"
    printf 'update add %s\nsend\n' "$fake" | update && x group01-0 dig +norec +short @{{master4}} group01.lab. DS | grep -q '^12345 ' \
        && ok "web page key adds a DS for group01.lab." || fail "can't add DS"
    printf 'update delete group01.lab. DS\nsend\n' | update && [ -z "$(x group01-0 dig +norec +short @{{master4}} group01.lab. DS)" ] \
        && ok "web page key deletes it" || fail "can't delete DS"
    for bad in "update add group01.lab. 60 IN NS evil.example." \
               "update add foo.lab. 60 IN DS 12345 13 2 0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF" \
               "update add ns.lab. 60 IN A 192.0.2.66"; do
        ! printf '%s\nsend\n' "$bad" | update >/dev/null 2>&1 || fail "allowed: $bad"
    done
    ok "web page key can't change NS, DS outside groupNN.lab. or other records"
    ! printf 'update add %s\nsend\n' "$fake" | m nsupdate >/dev/null 2>&1 \
        && ok "unsigned update refused" || fail "unsigned update accepted"

    # 6. a group signs its zone and publishes its DS: validated; wrong DS: SERVFAIL.
    ds=$(just _group_zone 1)
    ok "group01-0 signs group01.lab.; group01-1 and -2 serve it as secondaries"
    printf 'update add %s\nsend\n' "$(echo "$ds" | sed 's/ IN / 60 IN /')" | update
    out=$(x group01-0 dig @{{master4}} www.group01.lab. A +dnssec)
    echo "$out" | flags | grep -qw ad && ok "with the DS published, www.group01.lab. validates (ad)" \
        || fail "group01.lab. not validated: $(echo "$out" | grep -E 'status|flags')"
    out=$(x group01-0 delv-lab @{{master4}} group01.lab. SOA 2>&1 || true)
    echo "$out" | grep -q 'fully validated' \
        && ok "delv-lab: group01.lab. SOA fully validated" || fail "delv-lab didn't validate group01.lab.: $out"
    anchor=$(cat "$root/shared/lab-anchor.conf")
    docker restart {{master_name}} >/dev/null; just _wait_resolver
    [ "$(cat "$root/shared/lab-anchor.conf")" = "$anchor" ] \
        && x group01-0 dig @{{master4}} www.group01.lab. A +dnssec | flags | grep -qw ad \
        && ok "after a master restart, the DS and lab.'s trust anchor are unchanged and it still validates" \
        || fail "master restart lost the DS or changed the anchor"
    # Same key tag and algorithm, digest replaced: a typo at the registrar.
    wrong=$(echo "$ds" | awk '{ $NF = sprintf("%064d", 0); print }' | sed 's/ IN / 60 IN /')
    printf 'update delete group01.lab. DS\nupdate add %s\nsend\n' "$wrong" | update
    m rndc flushtree group01.lab. resolver
    out=$(x group01-0 dig @{{master4}} www.group01.lab. A)
    echo "$out" | grep -q 'status: SERVFAIL' && ok "with a wrong DS, www.group01.lab. is SERVFAIL" \
        || fail "wrong DS didn't break validation: $(echo "$out" | grep -E 'status|flags'); DS in lab.: $(x group01-0 dig +short +norec @{{master4}} group01.lab. DS)"
    echo "all master checks passed"

# Bring up master, groups 1-2 and the web page; check login, controls, DS form, terminals and authorization; tear down.
test-web: build
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{state}}/test"
    nodes=(group01-0 group01-1 group01-2 group02-0 group02-1 group02-2)
    if docker network inspect {{network}} >/dev/null 2>&1 || docker container inspect {{web_name}} >/dev/null 2>&1; then
        echo "A {{network}} environment or {{web_name}} already exists on this host; test-web needs them absent." >&2; exit 1
    fi
    tmp=$(mktemp -d)
    cleanup() {
        docker rm -f {{web_name}} {{master_name}} "${nodes[@]}" >/dev/null 2>&1 || true
        docker network rm {{network}} {{uplink}} {{front}} >/dev/null 2>&1 || true
        sudo rm -rf "$root" "$tmp"
    }
    trap cleanup EXIT
    cleanup; mkdir -p "$tmp"
    just _network
    just groups=2 _master "$root"
    for g in 1 2; do for n in 0 1 2; do just _node "$root" $g $n; done; done
    for c in "${nodes[@]}"; do just _wait "$c"; done
    just groups=2 _credentials "$root"
    just _web "$root"
    ok() { echo "ok   $*"; }
    fail() { echo "FAIL $*" >&2; exit 1; }
    url=http://127.0.0.1:{{web_port}}
    pass() { awk -v u="$1" '$1 == u { print $2 }' "$root/credentials"; }
    # login USER PASSWORD -> HTTP status; cookies in $tmp/USER
    login() { curl -s -o /dev/null -w '%{http_code}' -c "$tmp/$1" -b "$tmp/$1" --data-urlencode "username=$1" --data-urlencode "password=$2" "$url/login"; }
    # api USER METHOD PATH -> body; status in $tmp/status
    api() { curl -s -o "$tmp/body" -w '%{http_code}' -b "$tmp/$1" -X "$2" "$url$3" > "$tmp/status"; cat "$tmp/body"; }
    names() { python3 -c 'import json, sys; print(" ".join(n["name"] for n in json.load(sys.stdin)["nodes"]))'; }
    state_of() { api "$1" GET /api/nodes | python3 -c 'import json, sys; print({n["name"]: n["status"] for n in json.load(sys.stdin)["nodes"]}[sys.argv[1]])' "$2"; }

    [ "$(login group01 wrong-password)" = 401 ] && [ "$(login nobody "$(pass group01)")" = 401 ] \
        && ok "wrong password or unknown user rejected" || fail "bad login accepted"
    [ "$(login group01 "$(pass group01)")" = 303 ] && ok "group01 logs in" || fail "group01 can't log in"
    [ "$(api group01 GET /api/nodes | names)" = "group01-0 group01-1 group01-2" ] \
        && ok "group01 sees exactly group01-0/1/2" || fail "group01 sees: $(api group01 GET /api/nodes | names)"
    login instructor "$(pass instructor)" >/dev/null
    [ "$(api instructor GET /api/nodes | names)" = "{{master_name}} ${nodes[*]}" ] \
        && ok "instructor sees the master and every node" || fail "instructor sees: $(api instructor GET /api/nodes | names)"
    api group01 GET /api/nodes | python3 -c 'import json, sys
    n = json.load(sys.stdin)["nodes"][0]
    assert (n["name"], n["status"], n["ipv4"], n["ipv6"]) == ("group01-0", "running", "10.53.1.10", "fd53::1:10"), n
    assert n["uptime"] is not None and n["uptime"] >= 0, n' && ok "node shows state, IPv4, IPv6 and uptime" || fail "node details wrong"

    for target in group02-0 {{master_name}} dnslab-web no-such-node; do
        api group01 POST "/api/nodes/$target/stop" >/dev/null
        [ "$(cat "$tmp/status")" = 403 ] || fail "group01 stopping $target got $(cat "$tmp/status")"
    done
    [ "$(docker inspect -f '{{{{.State.Status}}' group02-0)" = running ] && [ "$(docker inspect -f '{{{{.State.Status}}' {{master_name}})" = running ] \
        && ok "group01 gets 403 for another group's node, the master, the web app or unknown names" || fail "a forbidden action ran"

    t0=$(date +%s)
    api group01 POST /api/nodes/group01-1/stop >/dev/null; [ "$(cat "$tmp/status")" = 200 ] || fail "stop: $(cat "$tmp/status")"
    [ "$(state_of group01 group01-1)" = exited ] && (( $(date +%s) - t0 <= 5 )) \
        && ok "Stop: group01-1 shows exited within 5 s ($(( $(date +%s) - t0 )) s)" || fail "stop not reflected"
    api group01 POST /api/nodes/group01-1/start >/dev/null
    [ "$(state_of group01 group01-1)" = running ] && ok "Start: group01-1 running again" || fail "start not reflected"
    before=$(docker inspect -f '{{{{.State.StartedAt}}' group01-1)
    api group01 POST /api/nodes/group01-1/restart >/dev/null
    [ "$(state_of group01 group01-1)" = running ] && [ "$(docker inspect -f '{{{{.State.StartedAt}}' group01-1)" != "$before" ] \
        && ok "Restart: group01-1 restarted and running" || fail "restart not reflected"

    printf 'zone "restart-test.example" { type primary; file "/etc/bind/db.empty"; };\n' \
        | docker exec -i group01-0 tee -a /etc/bind/named.conf.local >/dev/null
    api group01 POST /api/nodes/group01-0/restart >/dev/null
    just _wait group01-0
    docker exec group01-0 dig +norec @127.0.0.1 restart-test.example SOA | grep -q 'status: NOERROR' \
        && ok "after editing named.conf.local and Restart, named serves the new zone" || fail "restart didn't apply config"

    api instructor POST /api/nodes/group02-2/restart >/dev/null
    [ "$(cat "$tmp/status")" = 200 ] && ok "instructor can restart another group's node" || fail "instructor restart: $(cat "$tmp/status")"

    # DS form (#10), through the same API the page uses
    # ds USER GROUP KEY VALUE [/delete] -> body; POSTs {"KEY": VALUE} to /api/ds/GROUP[/delete]
    ds() { curl -s -o "$tmp/body" -w '%{http_code}' -b "$tmp/$1" -H 'Content-Type: application/json' \
        --data "$(python3 -c 'import json, sys; print(json.dumps({sys.argv[1]: sys.argv[2]}))' "$3" "$4")" \
        "$url/api/ds/$2${5:-}" > "$tmp/status"; cat "$tmp/body"; }
    detail() { python3 -c 'import json, sys; print(json.load(sys.stdin).get("detail", ""))'; }
    lab_ds() { docker exec group01-0 dig @{{master4}} "$1" DS +norec +short; }
    validated() { docker exec group01-0 delv-lab @{{master4}} group01.lab. SOA 2>&1 | grep 'fully validated' >/dev/null; }
    ksk=$(just _group_zone 1)
    tag=$(echo "$ksk" | awk '{print $4}')
    ok "group01-0 signs group01.lab. (KSK $tag); no DS in lab. yet"
    ! validated && ok "without a DS, delv-lab doesn't validate group01.lab." || fail "validated without a DS"
    other=${ksk/group01.lab./group02.lab.}
    for case in "other group's name|$other|Solo podés publicar DS para group01.lab." \
                "malformed digest|group01.lab. IN DS $tag 13 2 XYZ|no es válido" \
                "short digest|group01.lab. IN DS $tag 13 2 0123ABCD|no es válido" \
                "NS record|group01.lab. IN NS ns.evil.example.|no DS" \
                "A record|group01.lab. 60 IN A 192.0.2.1|no DS" \
                "garbage|hola|No es un registro DS"; do
        IFS='|' read -r why line want <<<"$case"
        msg=$(ds group01 group01 text "$line" | detail)
        [ "$(cat "$tmp/status")" = 400 ] && [[ "$msg" == *"$want"* ]] || fail "$why: got $(cat "$tmp/status") '$msg'"
    done
    ds group01 group02 text "$other" >/dev/null
    [ "$(cat "$tmp/status")" = 403 ] || fail "group01 posting to group02's DS got $(cat "$tmp/status")"
    [ -z "$(lab_ds group01.lab.)" ] && [ -z "$(lab_ds group02.lab.)" ] \
        && ok "rejected with a message, lab. unchanged: another group's name or form, malformed or short digest, NS, A, garbage" \
        || fail "a rejected DS reached lab."
    ds group01 group01 text "$ksk" >/dev/null
    [ "$(cat "$tmp/status")" = 200 ] && lab_ds group01.lab. | grep "^$tag 13 2 " >/dev/null \
        && ok "pasting dnssec-dsfromkey's line publishes it: dig @{{master4}} group01.lab. DS +norec shows $tag" \
        || fail "publish: $(cat "$tmp/status") $(cat "$tmp/body")"
    validated && docker exec group01-0 dig @{{master4}} www.group01.lab. A +dnssec | grep -E '^;; flags:.* ad[ ;]' >/dev/null \
        && ok "with the DS published, delv-lab: group01.lab. SOA fully validated; dig gets ad" || fail "not validated after publishing"
    [ "$(ds group01 group01 text "$ksk" | python3 -c 'import json, sys; print(json.load(sys.stdin)["message"])')" = "Ese DS ya estaba publicado." ] \
        && ok "publishing the same DS again is a no-op" || fail "duplicate publish: $(cat "$tmp/body")"
    spare="group01.lab. 3600 IN DS 4242 13 2 $(printf '%064d' 42)"
    ds group01 group01 text "$spare" >/dev/null
    [ "$(lab_ds group01.lab. | wc -l)" = 2 ] || fail "second DS not added"
    ds group01 group01 record "4242 13 2 $(printf '%064d' 42)" /delete >/dev/null
    [ "$(cat "$tmp/status")" = 200 ] && [ "$(lab_ds group01.lab. | awk '{print $1}')" = "$tag" ] \
        && ok "a second DS (with TTL) is added; removing it leaves only the KSK's" || fail "remove one of two: $(cat "$tmp/body")"
    api group01 GET /api/ds/group01 | python3 -c 'import json, sys
    d = json.load(sys.stdin)
    assert d["zone"] == "group01.lab." and [r["key_tag"] for r in d["records"]] == [int(sys.argv[1])], d' "$tag" \
        && ok "the page lists the published DS" || fail "list: $(cat "$tmp/body")"
    ds group01 group01 record "${ksk#* DS }" /delete >/dev/null
    [ "$(cat "$tmp/status")" = 200 ] && [ -z "$(lab_ds group01.lab.)" ] && ! validated \
        && ok "removing the DS takes it out of lab.; group01.lab. is no longer validated" || fail "remove: $(cat "$tmp/body")"
    ds group01 group01 record "${ksk#* DS }" /delete >/dev/null
    [ "$(cat "$tmp/status")" = 404 ] || fail "removing a missing DS got $(cat "$tmp/status")"
    ds instructor group02 text "$other" >/dev/null && lab_ds group02.lab. | grep "^$tag " >/dev/null \
        && ds instructor group02 record "${other#* DS }" /delete >/dev/null && [ -z "$(lab_ds group02.lab.)" ] \
        && ok "instructor publishes and removes a DS for group02" || fail "instructor DS: $(cat "$tmp/body")"

    curl -s -o /dev/null -b "$tmp/group01" -c "$tmp/group01" -X POST "$url/logout"
    api group01 GET /api/nodes >/dev/null
    [ "$(cat "$tmp/status")" = 401 ] && ok "after logout, the API answers 401" || fail "session survives logout"
    [ "$(curl -s -o /dev/null -w '%{http_code}' "$url/")" = 303 ] && ok "page redirects to login without a session" || fail "page open without login"

    # Terminals (#9): driven over the websocket from inside the web container
    docker exec -i -e PW_GROUP01="$(pass group01)" -e PW_GROUP02="$(pass group02)" -e PW_INSTRUCTOR="$(pass instructor)" \
        {{web_name}} python - < web/tests/terminal_check.py | grep -v '^all terminal'
    echo "all web checks passed"

# Bring up master, group01-0, the web page and Caddy; check HTTPS with the self-signed certificate; tear down.
test-https: build
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{state}}/test"
    if docker network inspect {{network}} >/dev/null 2>&1 || docker container inspect {{web_name}} {{caddy_name}} >/dev/null 2>&1; then
        echo "A {{network}} environment, {{web_name}} or {{caddy_name}} already exists on this host; test-https needs them absent." >&2; exit 1
    fi
    tmp=$(mktemp -d)
    cleanup() {
        docker rm -f {{caddy_name}} {{web_name}} {{master_name}} group01-0 >/dev/null 2>&1 || true
        docker network rm {{network}} {{uplink}} {{front}} >/dev/null 2>&1 || true
        sudo rm -rf "$root" "$tmp"
    }
    trap cleanup EXIT
    cleanup; mkdir -p "$tmp"
    docker pull -q {{caddy_image}} >/dev/null
    just _network
    just groups=1 _master "$root"
    just _node "$root" 1 0; just _wait group01-0
    just groups=1 _credentials "$root"
    just _web "$root"
    just _cert "$root"
    just _caddy "$root"
    ok() { echo "ok   $*"; }
    fail() { echo "FAIL $*" >&2; exit 1; }
    pass() { awk -v u="$1" '$1 == u { print $2 }' "$root/credentials"; }
    cert="$root/caddy/cert.pem"
    # Every request goes to this host's Caddy, by name, verifying the certificate.
    c() { curl -s --resolve {{host}}:443:127.0.0.1 --resolve {{host}}:80:127.0.0.1 --cacert "$cert" "$@"; }
    served_fp() { openssl s_client -connect 127.0.0.1:443 -servername {{host}} </dev/null 2>/dev/null | openssl x509 -noout -fingerprint -sha256; }
    file_fp=$(openssl x509 -in "$cert" -noout -fingerprint -sha256)

    [ "$(c -o "$tmp/page" -w '%{http_code}' https://{{host}}/login)" = 200 ] && grep 'Ingresar' "$tmp/page" >/dev/null \
        && ok "https://{{host}}/login serves the login page; the certificate verifies against $cert" || fail "HTTPS login page"
    [ "$(served_fp)" = "$file_fp" ] && ok "Caddy serves the self-signed certificate (${file_fp#*=})" || fail "served certificate differs"
    read -r code loc < <(c -o /dev/null -w '%{http_code} %{redirect_url}\n' http://{{host}}/login)
    [[ "$code" =~ ^30[178]$ ]] && [ "$loc" = "https://{{host}}/login" ] \
        && ok "http:// redirects to https:// ($code)" || fail "no redirect: $code $loc"

    c -D "$tmp/headers" -o /dev/null -c "$tmp/jar" --data-urlencode username=group01 --data-urlencode "password=$(pass group01)" https://{{host}}/login
    grep -i '^set-cookie: session=' "$tmp/headers" | grep -i '; secure' >/dev/null \
        && ok "session cookie set over HTTPS has the Secure flag" || fail "cookie not Secure: $(grep -i set-cookie "$tmp/headers")"
    curl -s -D - -o /dev/null --data-urlencode username=group01 --data-urlencode "password=$(pass group01)" http://127.0.0.1:{{web_port}}/login \
        | grep -i '^set-cookie: session=' | grep -iv '; secure' >/dev/null \
        && ok "on the loopback port (tests, SSH tunnel) the cookie has no Secure flag" || fail "loopback cookie"
    c -b "$tmp/jar" https://{{host}}/api/nodes | grep '"group01-0"' >/dev/null \
        && [ "$(c -b "$tmp/jar" -o /dev/null -w '%{http_code}' -X POST https://{{host}}/api/nodes/group01-0/restart)" = 200 ] \
        && just _wait group01-0 \
        && [ "$(c -b "$tmp/jar" -o /dev/null -w '%{http_code}' https://{{host}}/api/ds/group01)" = 200 ] \
        && ok "over HTTPS: node list, Restart and the DS form's API work" || fail "API over HTTPS"
    caddy_ip=$(docker inspect -f '{{{{(index .NetworkSettings.Networks "{{front}}").IPAddress}}' {{caddy_name}})
    docker run --rm -i --network {{front}} --add-host {{host}}:"$caddy_ip" -v "$cert:/ca.pem:ro" \
        -e DNSLAB_HOST={{host}} -e PW_GROUP01="$(pass group01)" {{web_image}} python - < web/tests/https_check.py

    docker restart {{caddy_name}} >/dev/null
    for _ in $(seq 30); do c -o /dev/null https://{{host}}/login && break; sleep 1; done
    [ "$(served_fp)" = "$file_fp" ] && ok "after restarting Caddy, the same certificate" || fail "certificate changed after restart"
    just _cert "$root" | grep generated && fail "_cert regenerated an existing certificate" || true
    ok "_cert keeps an existing certificate for {{host}}"

    hostip=$(ip -4 route get 1.1.1.1 | awk '{ for (i = 1; i < NF; i++) if ($i == "src") print $(i + 1) }')
    probe() { docker run --rm --network {{uplink}} --entrypoint curl {{node_image}} -sk -m 3 -o /dev/null -w '%{http_code}' "$@" || true; }
    [ "$(probe --resolve {{host}}:443:"$hostip" https://{{host}}/login)" = 200 ] && [ "$(probe http://"$hostip":{{web_port}}/login)" = 000 ] \
        && ok "from outside the host ($hostip): 443 answers, {{web_port}} doesn't" || fail "port {{web_port}} reachable on $hostip"
    echo "all https checks passed"

# Run the real `init` with 2 groups, check it, `status` and a second `init`; tear down (keeps state/backups).
test-init: build
    #!/usr/bin/env bash
    set -euo pipefail
    found=$(just _existing)
    if [ -n "$found" ]; then
        echo "test-init needs a host without an environment; found:" >&2; echo "$found" >&2; exit 1
    fi
    trap 'just _teardown' EXIT
    ok() { echo "ok   $*"; }
    fail() { echo "FAIL $*" >&2; exit 1; }
    x() { docker exec group01-0 "$@"; }
    just groups=2 init

    want="dnslab-caddy dnslab-master dnslab-web group01-0 group01-1 group01-2 group02-0 group02-1 group02-2"
    have=$(docker ps --format '{{{{.Names}}' | grep -E '^(dnslab-|group)' | sort | tr '\n' ' ' | sed 's/ $//')
    [ "$have" = "$want" ] && ok "init with groups=2 runs exactly: $have" || fail "running: $have"
    for g in group01 group02; do
        [ "$(x dig +norec @{{master4}} $g.lab. NS | grep -cE "^$g\.lab\.\s.*\sNS\s")" = 3 ] || fail "$g.lab. not delegated"
    done
    x dig +norec @{{master4}} group03.lab. NS | grep 'status: NXDOMAIN' >/dev/null || fail "group03.lab. exists"
    ok "lab. delegates group01.lab. and group02.lab. (3 NS each); group03.lab. is NXDOMAIN"
    (( $(sysctl -n fs.inotify.max_user_instances) >= {{inotify_instances}} && $(sysctl -n fs.inotify.max_user_watches) >= {{inotify_watches}} )) \
        && ok "host inotify limits at least {{inotify_instances}} instances, {{inotify_watches}} watches" || fail "inotify limits: $(sysctl fs.inotify)"
    for c in {{master_name}} group01-0 group02-2; do docker exec $c systemctl restart named || fail "systemctl restart named in $c"; done
    ok "systemctl restart named works in the master and nodes"
    x dig @{{master4}} lab. SOA | grep -E '^;; flags:.* ad[ ;]' >/dev/null && ok "the resolver validates lab." || fail "lab. not validated"

    [ "$(stat -c %a "{{state}}/credentials")" = 600 ] \
        && [ "$(awk '!/^#/ { print $1 }' "{{state}}/credentials" | tr '\n' ' ')" = "instructor group01 group02 " ] \
        && ok "state/credentials: mode 600, instructor, group01, group02" || fail "credentials: $(ls -l "{{state}}/credentials")"
    [ "$(just credentials | grep -c '^group')" = 2 ] && ok "just credentials prints them" || fail "just credentials"
    [ "$(curl -s -o /dev/null -w '%{http_code}' --resolve {{host}}:443:127.0.0.1 --cacert "{{state}}/caddy/cert.pem" https://{{host}}/login)" = 200 ] \
        && ok "https://{{host}}/ serves the login page" || fail "web page over HTTPS"

    out=$(just status)
    for c in $want; do echo "$out" | grep -E "^$c +running " >/dev/null || fail "status doesn't show $c running: $out"; done
    echo "$out" | grep -E '^dnslab-master +running +10\.53\.0\.1 +fd53::1$' >/dev/null \
        && echo "$out" | grep -E '^group02-2 +running +10\.53\.2\.12 +fd53::2:12$' >/dev/null \
        && echo "$out" | grep '2 groups on https://{{host}}/' >/dev/null \
        && ok "just status lists every container with its state and addresses" || fail "status: $out"
    echo "$out" | sed 's/^/     /'

    snapshot() {
        docker ps -a --filter label=dnslab.role --format '{{{{.ID}}' | sort | xargs docker inspect -f '{{{{.Name}} {{{{.State.StartedAt}}'
        docker network ls --format '{{{{.ID}} {{{{.Name}}' | grep dns-lab
        sudo sha256sum "{{state}}/env" "{{state}}/credentials" "{{state}}/master/etc-bind/named.conf.lab" "{{state}}/caddy/cert.pem"
    }
    before=$(snapshot)
    if msg=$(just groups=3 init 2>&1); then fail "second init succeeded"; fi
    echo "$msg" | grep 'already exists on this host; init changed nothing' >/dev/null && [ "$(snapshot)" = "$before" ] \
        && ok "a second init (even with groups=3) refuses with a message and changes nothing" || fail "second init: $msg"
    echo "all init checks passed"

# Run init with 2 groups, sign group01.lab., back up, tear down, init and restore; check it validates again.
test-backup: build
    #!/usr/bin/env bash
    set -euo pipefail
    found=$(just _existing)
    if [ -n "$found" ]; then
        echo "test-backup needs a host without an environment; found:" >&2; echo "$found" >&2; exit 1
    fi
    mkdir -p "{{state}}/backups"
    old=$(ls "{{state}}/backups")
    cleanup() {
        just _teardown
        for f in $(ls "{{state}}/backups"); do echo "$old" | grep -qxF "$f" || rm -f "{{state}}/backups/$f"; done
    }
    trap cleanup EXIT
    ok() { echo "ok   $*"; }
    fail() { echo "FAIL $*" >&2; exit 1; }
    x() { docker exec "$@"; }
    validates() { x group02-0 dig @{{master4}} www.group01.lab. A +dnssec | grep -E '^;; flags:.* ad[ ;]' >/dev/null; }
    dsof() { x group01-0 dig +norec @127.0.0.1 group01.lab. DNSKEY | x -i group01-0 dnssec-dsfromkey -2 -f - group01.lab. | head -1; }
    just groups=2 init >/dev/null
    ds=$(just _group_zone 1)
    printf 'update add %s\nsend\n' "$(echo "$ds" | sed 's/ IN / 60 IN /')" | x -i {{master_name}} nsupdate -k /etc/bind/dnslab-webapp.key
    validates && ok "group01.lab. signed on group01-0, DS published, www.group01.lab. validates" || fail "setup: group01.lab. doesn't validate"
    creds=$(sha256sum < "{{state}}/credentials")
    docker stop group02-1 >/dev/null

    out=$(just backup)
    file=$(echo "$out" | sed -n 's/^saved \(.*\) (.*/\1/p')
    [[ "$file" =~ ^{{state}}/backups/dns-lab-{{host}}-[0-9]{8}-[0-9]{6}\.tar\.gz$ ]] && [ "$(stat -c %a "$file")" = 600 ] \
        && echo "$out" | grep -E '\([0-9.]+[KM]; 6 nodes, master, credentials\)$' >/dev/null \
        && ok "just backup, with group02-1 stopped: $(basename "$file"), mode 600, size printed" || fail "backup: $out"
    list=$(tar -tzf "$file")
    for c in $(just groups=2 _nodes); do for d in etc-bind var-cache-bind var-lib-bind; do
        echo "$list" | grep -xF "nodes/$c/$d/" >/dev/null || fail "no nodes/$c/$d/ in the backup"
    done; done
    for f in credentials env master/etc-bind/named.conf.lab shared/lab-anchor.conf; do echo "$list" | grep -xF "$f" >/dev/null || fail "no $f in the backup"; done
    ok "the backup has etc-bind, var-cache-bind and var-lib-bind for all 6 nodes, master/, shared/ and credentials"
    tag=$(printf '%05d' "$(echo "$ds" | awk '{ print $4 }')")
    [ "$(echo "$list" | grep -cE "^nodes/group01-0/[^/]+/Kgroup01\.lab\.\+013\+$tag\.(key|private|state)$")" = 3 ] \
        && ok "group01-0's KSK (Kgroup01.lab.+013+$tag .key, .private, .state) is in it" || fail "KSK files missing: $(echo "$list" | grep Kgroup01)"

    just _teardown
    just groups=2 init >/dev/null
    validates && fail "a fresh environment validates group01.lab. before the restore"
    tmp=$(mktemp -d); printf 'DNSLAB_GROUPS=3\nDNSLAB_HOST={{host}}\n' > "$tmp/env"; tar -czf "$tmp/other.tar.gz" -C "$tmp" env
    started=$(docker ps --filter label=dnslab.role --format '{{{{.Names}} {{{{.State}}' | sort)
    if msg=$(just restore "$tmp/other.tar.gz" 2>&1); then fail "restored a backup of a 3-group environment"; fi
    rm -rf "$tmp"
    echo "$msg" | grep 'with 3 groups' >/dev/null && [ "$(docker ps --filter label=dnslab.role --format '{{{{.Names}} {{{{.State}}' | sort)" = "$started" ] \
        && ok "restoring a 3-group backup into this 2-group environment refuses and stops nothing" || fail "mismatched restore: $msg"
    out=$(just restore "$file")
    echo "$out" | sed 's/^/     /'
    [ "$(sha256sum < "{{state}}/credentials")" = "$creds" ] && ok "after teardown, init and restore: the credentials are the backup's" || fail "credentials not restored"
    [ "$(dsof)" = "$ds" ] && ok "group01-0 serves group01.lab. signed with the same KSK" || fail "group01-0 DS now: $(dsof)"
    for n in 1 2; do
        x group01-$n dig +norec @127.0.0.1 group01.lab. SOA | grep -E '^;; flags:.* aa[ ;]' >/dev/null || fail "group01-$n doesn't serve group01.lab."
    done
    ok "group01-1 and -2 serve it as secondaries again"
    validates && ok "lab. still has the DS and the resolver validates www.group01.lab." || fail "group01.lab. doesn't validate after the restore"
    [ "$(docker ps --filter label=dnslab.role -q | wc -l)" = 9 ] && ok "every container is running, group02-1 included" || fail "not all running: $(just status)"
    [ "$(ls "{{state}}/backups" | grep -cvxF "$old")" = 2 ] && ok "restore first backed up the state it replaced" || fail "backups: $(ls "{{state}}/backups")"
    echo "all backup checks passed"

# Check destroy: no environment, answering no, destroy with backup, init again, skip_backup/yes/images; removes the images.
test-destroy: build
    #!/usr/bin/env bash
    set -euo pipefail
    found=$(just _existing)
    if [ -n "$found" ]; then
        echo "test-destroy needs a host without an environment; found:" >&2; echo "$found" >&2; exit 1
    fi
    mkdir -p "{{state}}/backups"
    old=$(ls "{{state}}/backups")
    new() { ls "{{state}}/backups" | grep -vxF "$old" || true; }
    cleanup() {
        just _teardown
        for f in $(new); do rm -f "{{state}}/backups/$f"; done
    }
    trap cleanup EXIT
    ok() { echo "ok   $*"; }
    fail() { echo "FAIL $*" >&2; exit 1; }
    gone() {
        [ -z "$(docker ps -aq --filter label=dnslab.role)" ] && ! docker network ls --format '{{{{.Name}}' | grep '^dns-lab' >/dev/null \
            && [ "$(ls -A "{{state}}")" = backups ]
    }

    out=$(just destroy </dev/null) && echo "$out" | grep 'nothing to destroy' >/dev/null \
        && ok "with no environment, destroy exits 0: $out" || fail "destroy with no environment: $out"

    just groups=2 init >/dev/null
    echo marker | docker exec -i group01-0 tee /etc/bind/dnslab-test-marker >/dev/null
    snapshot() {
        docker ps -a --filter label=dnslab.role --format '{{{{.ID}}' | sort | xargs docker inspect -f '{{{{.Name}} {{{{.State.StartedAt}}'
        docker network ls --format '{{{{.ID}} {{{{.Name}}' | grep dns-lab
        sudo find "{{state}}" -path "{{state}}/backups" -prune -o -type f -print0 | sort -z | sudo xargs -0 sha256sum
    }
    before=$(snapshot)
    if out=$(echo no | just destroy 2>&1); then fail "destroy went ahead after 'no'"; fi
    echo "$out" | grep 'destroy cancelled; nothing changed' >/dev/null && [ "$(snapshot)" = "$before" ] && [ -z "$(new)" ] \
        && ok "answering no cancels: environment untouched, no backup" || fail "after no: $out"
    if just destroy </dev/null >/dev/null 2>&1; then fail "destroy went ahead with no answer"; fi
    ok "no answer (stdin closed) cancels too"

    out=$(echo yes | just destroy)
    echo "$out" | sed 's/^/     /'
    gone && ok "after destroy: no lab containers or networks, only backups/ under state/" || fail "left behind: $(just _existing; ls -A "{{state}}")"
    [ "$(new | wc -l)" = 1 ] && tar -tzf "{{state}}/backups/$(new)" | grep -xF nodes/group01-0/etc-bind/dnslab-test-marker >/dev/null \
        && ok "destroy backed up first: $(new) has group01-0's files" || fail "no backup with the environment's files: $(new)"
    docker image inspect {{node_image}} {{master_image}} {{web_image}} {{caddy_image}} >/dev/null && ok "images kept" || fail "images removed"

    just groups=2 init >/dev/null
    ! docker exec group01-0 test -e /etc/bind/dnslab-test-marker \
        && docker exec group01-0 dig @{{master4}} lab. SOA | grep -E '^;; flags:.* ad[ ;]' >/dev/null \
        && [ "$(docker ps -q --filter label=dnslab.role | wc -l)" = 9 ] \
        && ok "init after destroy: a fresh environment, 9 containers running, lab. validates" || fail "init after destroy"

    n=$(new | wc -l)
    just skip_backup=true yes=true images=true destroy </dev/null | sed 's/^/     /'
    gone && [ "$(new | wc -l)" = "$n" ] && ok "destroy skip_backup=true yes=true: no prompt, no backup, all gone" || fail "skip_backup/yes"
    ! docker image inspect {{node_image}} >/dev/null 2>&1 && ! docker image inspect {{master_image}} >/dev/null 2>&1 \
        && ! docker image inspect {{web_image}} >/dev/null 2>&1 && ! docker image inspect {{caddy_image}} >/dev/null 2>&1 \
        && ok "images=true removed the lab images" || fail "images left"
    echo "all destroy checks passed"

# Print what of an environment exists on this host (containers, networks,
# state files), one per line; nothing if none. State backups don't count.
[private]
_existing:
    #!/usr/bin/env bash
    set -euo pipefail
    for c in $(docker ps -a --filter label=dnslab.role --format '{{{{.Names}}'); do echo "container $c"; done
    for n in {{network}} {{uplink}} {{front}}; do
        if docker network inspect "$n" >/dev/null 2>&1; then echo "network $n"; fi
    done
    for f in {{state_items}}; do
        if [ -e "{{state}}/$f" ]; then echo "state {{state}}/$f"; fi
    done

# Remove every lab container, the networks and everything under state/
# except backups/. destroy wraps it with a confirmation and a backup.
[private]
_teardown:
    #!/usr/bin/env bash
    set -euo pipefail
    ids=$(docker ps -aq --filter label=dnslab.role)
    [ -z "$ids" ] || docker rm -f $ids >/dev/null
    docker network rm {{network}} {{uplink}} {{front}} >/dev/null 2>&1 || true
    [ ! -d "{{state}}" ] || sudo find "{{state}}" -mindepth 1 -maxdepth 1 ! -name backups -exec rm -rf {} +

# Remove the lab images (destroy images=true); init builds or pulls them again.
[private]
_rmi:
    #!/usr/bin/env bash
    set -euo pipefail
    for i in {{master_image}} {{web_image}} {{node_image}} {{caddy_image}}; do
        if docker image inspect "$i" >/dev/null 2>&1; then docker rmi "$i" >/dev/null; echo "removed image $i"; fi
    done

# Raise the host's inotify limits to inotify_instances/inotify_watches if
# lower, persistently in sysctl_conf; never lowers them. Silent if enough.
[private]
_inotify:
    #!/usr/bin/env bash
    set -euo pipefail
    i=$(sysctl -n fs.inotify.max_user_instances); w=$(sysctl -n fs.inotify.max_user_watches)
    (( i >= {{inotify_instances}} && w >= {{inotify_watches}} )) && exit 0
    i=$(( i > {{inotify_instances}} ? i : {{inotify_instances}} )); w=$(( w > {{inotify_watches}} ? w : {{inotify_watches}} ))
    printf '# Written by dns-lab just init (#28): each lab container runs systemd as root,\n# and they share these per-user limits.\nfs.inotify.max_user_instances = %s\nfs.inotify.max_user_watches = %s\n' "$i" "$w" \
        | sudo tee "{{sysctl_conf}}" >/dev/null
    sudo sysctl -q -p "{{sysctl_conf}}"
    echo "raised the host's inotify limits for the containers' systemd: max_user_instances $i, max_user_watches $w (in {{sysctl_conf}})"

# Create the internal dns-lab network, the master's uplink and the web front network, if missing.
[private]
_network:
    @docker network inspect {{network}} >/dev/null 2>&1 || docker network create --internal \
        --subnet {{lab4}} --gateway 10.53.255.254 --ipv6 --subnet {{lab6}} --gateway fd53::ffff {{network}}
    @docker network inspect {{uplink}} >/dev/null 2>&1 || docker network create {{uplink}}
    @docker network inspect {{front}} >/dev/null 2>&1 || docker network create {{front}}

# Create and start the master: 10.53.0.1 on dns-lab plus the uplink, NAT,
# lab. delegating to `groups` groups, and the lab's resolver.
[private]
_master root=state:
    #!/usr/bin/env bash
    set -euo pipefail
    dir="{{root}}/master"
    mkdir -p "$dir"/{etc-bind,var-cache-bind,var-lib-bind} "{{root}}/shared"
    docker create --name {{master_name}} --hostname {{master_name}} {{node_run_flags}} \
        --network {{network}} --ip {{master4}} --ip6 {{master6}} \
        --sysctl net.ipv4.ip_forward=1 \
        -e DNSLAB_LAB4={{lab4}} -e DNSLAB_RESOLVER=127.0.0.1 -e DNSLAB_GROUPS={{groups}} \
        -v "$dir/etc-bind:/etc/bind" -v "$dir/var-cache-bind:/var/cache/bind" \
        -v "$dir/var-lib-bind:/var/lib/bind" -v "{{root}}/shared:/etc/dnslab" \
        --label dnslab.role=master \
        {{master_image}} >/dev/null
    docker network connect {{uplink}} {{master_name}}
    docker start {{master_name}} >/dev/null
    just _wait_resolver
    echo "started {{master_name}} ({{master4}}, {{master6}})"

# Wait up to 60 s each for the master's resolver to answer and to validate
# lab.: named is up a few seconds before it can resolve (root priming),
# and lab.'s trust anchor is only loaded once named has signed the zone
# (dnslab-lab-anchor). Nodes booting meanwhile would see lookups fail.
[private]
_wait_resolver:
    @for _ in $(seq 60); do docker exec {{master_name}} dig +time=1 +tries=1 @127.0.0.1 . SOA 2>/dev/null | grep "status: NOERROR" >/dev/null && break; sleep 1; done
    @for _ in $(seq 60); do docker exec {{master_name}} dig +time=1 +tries=1 @127.0.0.1 lab. SOA 2>/dev/null | grep -E "^;; flags:.* ad[ ;]" >/dev/null && exit 0; sleep 1; done; \
        echo "{{master_name}}: resolver not validating lab. after 60 s" >&2; exit 1

# Create and start node groupGG-N with its fixed addresses.
[private]
_node root g n:
    #!/usr/bin/env bash
    set -euo pipefail
    name=$(printf 'group%02d-%d' {{g}} {{n}})
    a4="10.53.$((10#{{g}})).$((10 + {{n}}))"; a6="fd53::$((10#{{g}})):$((10 + {{n}}))"
    dir="{{root}}/nodes/$name"
    mkdir -p "$dir"/{etc-bind,var-cache-bind,var-lib-bind}
    docker run -d --name "$name" --hostname "$name" {{node_run_flags}} \
        --network {{network}} --ip "$a4" --ip6 "$a6" \
        -e DNSLAB_GW4={{master4}} -e DNSLAB_RESOLVER={{master4}} \
        -v "$dir/etc-bind:/etc/bind" -v "$dir/var-cache-bind:/var/cache/bind" \
        -v "$dir/var-lib-bind:/var/lib/bind" -v "{{root}}/shared:/etc/dnslab:ro" \
        --label dnslab.role=node --label dnslab.group="${name%-*}" \
        {{node_image}} >/dev/null
    echo "started $name ($a4, $a6)"

# Generate the web page's passwords (instructor + one per group) and its
# session secret, unless they exist. Passwords are kept in clear text so
# `just credentials` can print them for handing out.
[private]
_credentials root=state:
    #!/usr/bin/env bash
    set -euo pipefail
    umask 077
    mkdir -p "{{root}}/web"
    pw() { tr -dc 'abcdefghijkmnpqrstuvwxyz23456789' < /dev/urandom | head -c 12 || true; }
    if [ ! -e "{{root}}/credentials" ]; then
        { echo "# Lab web page logins: name password"
          echo "instructor $(pw)"
          for g in $(seq 1 {{groups}}); do printf 'group%02d %s\n' "$g" "$(pw)"; done
        } > "{{root}}/credentials"
        echo "generated {{root}}/credentials"
    fi
    [ -e "{{root}}/web/session-secret" ] || head -c 32 /dev/urandom | base64 > "{{root}}/web/session-secret"

# Start the web page on 127.0.0.1:web_port and the dns-lab-front network,
# with the Docker socket mounted.
[private]
_web root=state:
    @docker run -d --name {{web_name}} --restart unless-stopped \
        --network {{front}} -p 127.0.0.1:{{web_port}}:8000 \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -v "{{root}}/credentials:/run/dnslab/credentials:ro" \
        -v "{{root}}/web/session-secret:/run/dnslab/session-secret:ro" \
        -e DNSLAB_CREDENTIALS=/run/dnslab/credentials \
        -e DNSLAB_SESSION_SECRET=/run/dnslab/session-secret \
        -e DNSLAB_NETWORK={{network}} \
        --label dnslab.role=web \
        {{web_image}} >/dev/null
    @for _ in $(seq 30); do curl -fs -o /dev/null http://127.0.0.1:{{web_port}}/login 2>/dev/null && exit 0; sleep 1; done; \
        echo "{{web_name}}: not answering on 127.0.0.1:{{web_port}} after 30 s" >&2; exit 1
    @echo "started {{web_name}} (http://127.0.0.1:{{web_port}})"

# As a group does in modules 3-4: groupGG-0 signs groupGG.lab. (KASP,
# inline signing) and groupGG-1/-2 serve it as secondaries, so every
# server the delegation points to answers. Prints the KSK's DS (SHA-256).
[private]
_group_zone g:
    #!/usr/bin/env bash
    set -euo pipefail
    zone=$(printf 'group%02d.lab' {{g}}); grp=$(printf 'group%02d' {{g}}); net="10.53.$((10#{{g}}))"
    x() { docker exec "$@"; }
    fail() { echo "FAIL $*" >&2; exit 1; }
    x -i "$grp-0" bash -s >&2 <<EOF
    set -e
    cat >> /etc/bind/named.conf.local <<'C'
    zone "$zone" { type primary; file "/var/lib/bind/db.$zone"; dnssec-policy default; inline-signing yes;
        allow-transfer { $net.0/24; }; also-notify { $net.11; $net.12; }; };
    C
    cat > /var/lib/bind/db.$zone <<'Z'
    \$TTL 60
    @    SOA ns0.$zone. hostmaster.$zone. 1 300 60 86400 60
    @    NS  ns0
    @    NS  ns1
    @    NS  ns2
    ns0  A   $net.10
    ns1  A   $net.11
    ns2  A   $net.12
    www  A   $net.10
    Z
    chown bind:bind /var/lib/bind/db.$zone
    rndc reconfig
    EOF
    for _ in $(seq 30); do
        ds=$(x "$grp-0" dig +norec @127.0.0.1 "$zone." DNSKEY | x -i "$grp-0" dnssec-dsfromkey -2 -f - "$zone." 2>/dev/null | head -1) || true
        [ -n "$ds" ] && break; sleep 1
    done
    [ -n "$ds" ] || fail "$grp-0 didn't sign $zone."
    for n in 1 2; do
        printf 'zone "%s" { type secondary; primaries { %s.10; }; file "/var/cache/bind/db.%s"; };\n' "$zone" "$net" "$zone" \
            | x -i "$grp-$n" tee -a /etc/bind/named.conf.local >/dev/null
        x "$grp-$n" rndc reconfig
    done
    want=$(x "$grp-0" dig +short +norec @127.0.0.1 "$zone." SOA | awk '{print $3}')
    for n in 1 2; do
        for _ in $(seq 30); do
            [ "$(x "$grp-$n" dig +short +norec @127.0.0.1 "$zone." SOA | awk '{print $3}')" = "$want" ] && break; sleep 1
        done
        x "$grp-$n" dig +norec @127.0.0.1 "$zone." DNSKEY | grep -q DNSKEY || fail "$grp-$n didn't transfer $zone."
    done
    echo "$ds"

# Generate the web page's self-signed certificate for `host` (#20), unless
# one for that name exists: one year, so students accept the browser's
# warning once per environment. Let's Encrypt replaces it in #11.
[private]
_cert root=state:
    #!/usr/bin/env bash
    set -euo pipefail
    dir="{{root}}/caddy"
    mkdir -p "$dir"
    if openssl x509 -in "$dir/cert.pem" -noout -ext subjectAltName 2>/dev/null | grep -w "DNS:{{host}}" >/dev/null; then
        exit 0
    fi
    (umask 077; openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 365 \
        -subj "/CN={{host}}" -addext "subjectAltName=DNS:{{host}}" \
        -keyout "$dir/key.pem" -out "$dir/cert.pem" 2>/dev/null)
    chmod 644 "$dir/cert.pem"
    echo "generated $dir/cert.pem for {{host}}"

# Start Caddy on ports 80 and 443 in front of the web page (after _web).
[private]
_caddy root=state:
    @docker run -d --name {{caddy_name}} --restart unless-stopped \
        --network {{front}} -p 80:80 -p 443:443 \
        -v "{{justfile_directory()}}/caddy/Caddyfile:/etc/caddy/Caddyfile:ro" \
        -v "{{root}}/caddy:/certs:ro" \
        -e DNSLAB_HOST={{host}} \
        --label dnslab.role=caddy \
        {{caddy_image}} >/dev/null
    @for _ in $(seq 30); do curl -sk -o /dev/null --resolve {{host}}:443:127.0.0.1 https://{{host}}/login 2>/dev/null && exit 0; sleep 1; done; \
        echo "{{caddy_name}}: not answering on https://{{host}} after 30 s" >&2; exit 1
    @echo "started {{caddy_name}} (https://{{host}})"

# Wait up to 30 s for a container's named to be up.
[private]
_wait name:
    @for _ in $(seq 30); do docker exec {{name}} systemctl is-active -q named 2>/dev/null && exit 0; sleep 1; done; \
        echo "{{name}}: named not up after 30 s" >&2; exit 1

# Boot a throwaway node and check it: systemd, bind9, tools, bind mounts, clean stop.
test-node: build
    #!/usr/bin/env bash
    set -euo pipefail
    name=dnslab-test-node
    dir="{{state}}/test/$name"
    cleanup() { docker rm -f "$name" >/dev/null 2>&1 || true; sudo rm -rf "{{state}}/test"; }
    trap cleanup EXIT
    cleanup
    mkdir -p "$dir"/{etc-bind,var-cache-bind,var-lib-bind}
    docker run -d --name "$name" --hostname "$name" {{node_run_flags}} \
        -v "$dir/etc-bind:/etc/bind" -v "$dir/var-cache-bind:/var/cache/bind" \
        -v "$dir/var-lib-bind:/var/lib/bind" {{node_image}} >/dev/null
    x() { docker exec "$name" "$@"; }
    ok() { echo "ok   $*"; }
    fail() { echo "FAIL $*" >&2; exit 1; }
    for _ in $(seq 30); do x systemctl is-active -q named 2>/dev/null && break; sleep 1; done
    [ "$(x systemctl is-system-running || true)" = running ] && ok "systemd running, no failed units" \
        || { x systemctl --failed; fail "systemd not running cleanly"; }
    x systemctl is-active -q bind9 && ok "systemctl: bind9 active" || fail "bind9 not active"
    x journalctl -u named | grep 'running as: named' >/dev/null && ok "journalctl -u named shows named's log" \
        || fail "no named log in the journal"
    x rndc status | grep 'server is up' >/dev/null && ok "rndc status" || fail "rndc status"
    x named-checkconf && ok "named-checkconf" || fail "named-checkconf"
    for t in dig delv drill dnssec-keygen dnssec-signzone named-checkzone; do
        x sh -c "command -v $t >/dev/null" || fail "$t missing"
    done
    ok "dig delv drill dnssec-keygen dnssec-signzone named-checkzone present"
    x sh -c "command -v htop >/dev/null && command -v ifconfig >/dev/null" && ok "htop and ifconfig present" || fail "htop or ifconfig missing"
    x sh -c "dpkg -s tree >/dev/null 2>&1" && fail "tree is already installed; pick another package for the apt check"
    x apt-get install -y -q tree >/dev/null 2>&1 && x tree -L 1 /etc/bind >/dev/null \
        && ok "apt-get install tree works without apt update first" || fail "apt-get install without apt update"
    [ "$(x dig +short @127.0.0.1 localhost A)" = 127.0.0.1 ] && ok "named answers queries" || fail "named doesn't answer"
    [ -s "$dir/etc-bind/named.conf" ] && sudo test -s "$dir/etc-bind/rndc.key" \
        && ok "empty bind mount seeded, rndc.key generated" || fail "bind mount not seeded"
    mark="// dnslab test $(date +%s)"
    echo "$mark" | sudo tee -a "$dir/etc-bind/named.conf.local" >/dev/null
    [ "$(x tail -1 /etc/bind/named.conf.local)" = "$mark" ] && ok "host edit visible in /etc/bind" || fail "host edit not visible"
    docker restart "$name" >/dev/null
    for _ in $(seq 30); do x systemctl is-active -q named 2>/dev/null && break; sleep 1; done
    [ "$(x tail -1 /etc/bind/named.conf.local)" = "$mark" ] && x systemctl is-active -q named \
        && ok "edit survives docker restart, named back up" || fail "edit lost or named down after restart"
    start=$(date +%s)
    docker stop "$name" >/dev/null
    took=$(( $(date +%s) - start ))
    code=$(docker inspect "$name" --format '{{{{.State.ExitCode}}')
    (( took < 10 )) && [ "$code" = 0 ] && ok "docker stop clean in ${took}s" || fail "stop took ${took}s, exit $code"
    [ "$(docker inspect "$name" --format '{{{{.HostConfig.Privileged}}')" = false ] && ok "not privileged" || fail "privileged"
    echo "all node checks passed"

# Fail early on a bad parameter. Two-digit group names and the
# 10.53.GG.0/24 addressing (GOAL.md) cap the lab at 99 groups.
[private]
_check:
    @[[ "{{groups}}" =~ ^[0-9]+$ ]] && (( {{groups}} >= 1 && {{groups}} <= 99 )) \
        || { echo "groups must be a number from 1 to 99, got '{{groups}}'" >&2; exit 1; }
    @[[ -n "{{host}}" ]] || { echo "host must not be empty" >&2; exit 1; }

# Node container names, one per line.
[private]
_nodes:
    @for g in $(seq 1 {{groups}}); do for n in 0 1 2; do printf 'group%02d-%d\n' $g $n; done; done
