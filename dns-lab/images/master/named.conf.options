// The master's named.conf.options, seeded into an empty /etc/bind on
// first boot. Views, zones and ACLs are in named.conf.lab.
options {
	directory "/var/cache/bind";
	key-directory "/var/lib/bind/keys";

	dnssec-validation auto;

	// With a cold cache, names whose nameservers live in other domains
	// (archive.ubuntu.com -> ns*.canonical.com, pypi.org -> four
	// awsdns-* domains) take more than the default 50 upstream queries
	// to resolve, and the resolver answers SERVFAIL for a while (#40).
	max-recursion-queries 200;

	listen-on-v6 { any; };
};

// The master has an IPv6 address on the lab network (fd53::1) but no IPv6
// route to the Internet (GOAL.md: IPv6 is lab-internal in M0). Queries to
// IPv6 servers fail at once with "network unreachable" and named moves on
// to IPv4. Don't mark ::/0 bogus: that made cold-cache lookups fail more
// often, not less (#40).
